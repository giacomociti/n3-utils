@prefix log: <http://www.w3.org/2000/10/swap/log#> .
@prefix wdt: <http://www.wikidata.org/prop/direct/> .
@prefix wd: <http://www.wikidata.org/entity/> .
@prefix sparql: <https://raw.githubusercontent.com/giacomociti/n3-utils/refs/heads/main/builtins/sparql.js#> .

# empty on purpose, just to trigger loading of the sparql builtin in the eyeling playground (https://eyereasoner.github.io/eyeling/playground)
# using "Load from URL" https://raw.githubusercontent.com/giacomociti/n3-utils/refs/heads/main/builtins/sparql.n3

# { 
#     <https://qlever.dev/api/wikidata> sparql:query {
#         wd:Q12418 wdt:P1476 ?title .
#         ([] 'it') log:langlit ?title .
#     } .
# }
# => 
# { 
#     wd:Q12418 wdt:P1476 ?title
# } .

