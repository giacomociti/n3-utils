# npx eyeling ../rules.n3 sortByProperty.n3 > sortByProperty_out.ttl

@prefix : <https://raw.githubusercontent.com/giacomociti/n3-utils/refs/heads/main/rules.n3#> .
@prefix ex: <http://example.org/> .

<> :test 
    (ex:p (ex:test1 ex:test2 ex:test3)) ,
    (ex:p ()) .
 

ex:test1 ex:p 1 .
ex:test2 ex:p 3 .
ex:test3 ex:p 2 .

{ 
    <> :test ?test .
    ?test :sortByProperty ?sorted 
} => { 
    ?test ex:sortByProperty ?sorted 
} . 
