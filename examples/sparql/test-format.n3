# npx eyeling --builtin ../../builtins/sparql.js test-format.n3 

@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix string: <http://www.w3.org/2000/10/swap/string#> .
@prefix log: <http://www.w3.org/2000/10/swap/log#> .
@prefix ex: <http://example.org/> .
@prefix : <#> .
@prefix sparql: <https://raw.githubusercontent.com/giacomociti/n3-utils/refs/heads/main/builtins/sparql.js#> .

{ 
    ?query :name ?name .
    ('#' ?name ?query '\n\n') string:concatenation ?result .
} 
=> 
{ 
    [] log:outputString ?result .
} .


{ 
    ?query sparql:query {}
} 
=> 
{ 
    ?query :name "empty" .
} .

{ 
   ?query sparql:query  {
        ?s a ex:Person ;
            ex:name ?name .
    }
} 
=> 
{ 
    ?query :name "bgp" .
} .

{ 
    ?query sparql:query {
        ?s ex:name ?name .
        (sparql:concat "Hello " ?name) sparql:bind ?greeting
    }
} 
=> 
{ 
    ?query :name "bind" .
} .

{ 
    ?query sparql:query {
        ?s ex:name ?name .
        [] sparql:filter (sparql:notEqualTo ?name "") .
    }
} 
=> 
{ 
    ?query :name "filter" .
} .

{ 
    ?query sparql:query {
        ?s a ex:Person .
        [] sparql:minus { ?s ex:name "" } .
    }
} 
=> 
{ 
    ?query :name "minus" .
} .

{ 
    ?query sparql:query {
        ?s a ex:Person .
        [] sparql:optional { ?s ex:name ?name } .
    }
} 
=> 
{ 
    ?query :name "optional" .
} .

{ 
    ?query sparql:query {
        ?s ex:name ?name .
        [] sparql:query { 
            ?s a ex:Person .
            [ 
                sparql:select (?s) ;
                sparql:limit 10 ; 
                sparql:offset 20 ; 
                sparql:orderBy ((sparql:asc ?s)) 
            ]
        }
    }
} 
=> 
{ 
    ?query :name "subquery" .
} .

{ 
    ?query sparql:query {
        ?s a ex:Person .
        { ?s ex:name ?name } sparql:union { ?s ex:nickname ?name } .
    } .
} 
=> 
{ 
    ?query :name "union" .
} .

{ 
    ?query sparql:query {
        (
            sparql:add 
                (sparql:multiply 2 (sparql:subtract 5 3)) 
                (sparql:divide 10 2)
        ) sparql:bind ?x .
    }
} 
=> 
{ 
    ?query :name "arithmetic" .
} .

{ 
   ?query sparql:query  {
        10 sparql:bind ?x .
        [] sparql:filter (
            sparql:or
                (sparql:and 
                    (sparql:greaterThan ?x 5) 
                    (sparql:lessThan ?x 15)
                ) 
                (sparql:not (sparql:equalTo ?x 10))
            
        ) .
    }
} 
=> 
{ 
    ?query :name "comparison" .
} .


{ 
    ?query sparql:query {
        [
            sparql:select (?place (sparql:bind ?count (sparql:count ?person))) ;
            sparql:from (ex:People ex:PeopleDetails) ;
            sparql:groupBy (?place) ;
            sparql:having (sparql:greaterThan (sparql:count ?person) 10) ;
            sparql:orderBy ((sparql:desc ?place)) ;
            sparql:limit 5 ;
            sparql:offset 10
        ] .

        ?person (sparql:seq rdf:type (sparql:zeroOrMore rdfs:subClassOf)) ex:Person .
        ?person ex:birthPlace ?place .
    }
} 
=> 
{ 
    ?query :name "complex grouping" .
} .