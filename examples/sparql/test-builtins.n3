# npx eyeling --builtin ../../builtins/sparql.js test-builtins.n3 

@prefix string: <http://www.w3.org/2000/10/swap/string#> .
@prefix time: <http://www.w3.org/2000/10/swap/time#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix crypto: <http://www.w3.org/2000/10/swap/crypto#> .
@prefix log: <http://www.w3.org/2000/10/swap/log#> .
@prefix list: <http://www.w3.org/2000/10/swap/list#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix math: <http://www.w3.org/2000/10/swap/math#> .
@prefix ex: <http://example.org/> .
@prefix : <#> .
@prefix sparql: <https://raw.githubusercontent.com/giacomociti/n3-utils/refs/heads/main/builtins/sparql.js#> .

# any SPARQL endpoint can be used here, as the examples don't rely on any specific data
:let :endpoint <http://localhost:7001> .

# change :allTests to crypto:sha to only run the SHA1 tests, etc.
:test :enabled :allTests .

{ :test :enabled ?test } <= { :test :enabled :allTests } .



{ 
    :test :enabled crypto:sha .
    :let :endpoint ?endpoint .
    ?endpoint sparql:query {
        ?x list:in (1 "a" "b" ex:c) .
        ?x crypto:sha ?sha . # only strings have a sha
    } .
    # SELECT * WHERE {
    #     VALUES ?x { 1 "a" "b" <http://example.org/c> }
    #     BIND(SHA1(?x) AS ?sha)
    # }
}
=> 
{ 
    crypto:sha :result1 (?x ?sha) . 
} .

{ 
    :test :enabled crypto:sha .
    :let :endpoint ?endpoint .
    ?endpoint sparql:query {
        ?x list:in ("a" "b") .
        ?x crypto:sha "86f7e437faa5a7fce15d1ddcb9eaeaea377667b8" .
    } .
    # SELECT * WHERE {
    #     VALUES ?x { "a" "b"}
    #     FILTER(SHA1(?x) = "86f7e437faa5a7fce15d1ddcb9eaeaea377667b8")
    # }
}
=> 
{ 
    crypto:sha :result2 ?x .
} .

{ 
    :test :enabled crypto:sha .
    :let :endpoint ?endpoint .
    ?endpoint sparql:query {
        ?x list:in ("a" "b") .
        ?sha list:in ("e9d71f5ee7c92d6dc9e92ffdad17b8bd49418f98") .
        ?x crypto:sha ?sha .
    } .
    # SELECT * WHERE {
    #   VALUES ?x { "a" "b" }
    #   VALUES ?sha { "e9d71f5ee7c92d6dc9e92ffdad17b8bd49418f98" }
    #   FILTER(SHA1(?x) = ?sha)
    # }
}
=> 
{ 
    crypto:sha :result3 (?x ?sha) . 
} .

{ 
    :test :enabled math:greaterThan .
    :let :endpoint ?endpoint .
    ?endpoint sparql:query {
        ?n list:in (1 2 3 4 5) .
        ?n math:greaterThan 3 .
    } .
    # SELECT * WHERE {
    #   VALUES ?n { 1 2 3 4 5 }
    #   FILTER (?n > 3)
    # }
} 
=> 
{ 
    math:greaterThan :result ?n .
} .


{ 
    :test :enabled math:lessThan .
    :let :endpoint ?endpoint .
    ?endpoint sparql:query {
        ?n list:in (1 2 3 4 5) .
        ?n math:lessThan 3 .
    } .
    # SELECT * WHERE {
    #   VALUES ?n { 1 2 3 4 5 }
    #   FILTER (?n < 3)
    # }
} 
=> 
{ 
    math:lessThan :result ?n .
} .

{ 
    :test :enabled math:notGreaterThan .
    :let :endpoint ?endpoint .
    ?endpoint sparql:query {
        ?n list:in (1 2 3 4 5) .
        ?n math:notGreaterThan 3 .
    } .
    # SELECT * WHERE {
    #   VALUES ?n { 1 2 3 4 5 }
    #   FILTER (?n <= 3)
    # }
} 
=> 
{ 
    math:notGreaterThan :result ?n . 
} .

{ 
    :test :enabled math:notLessThan .
    :let :endpoint ?endpoint .
    ?endpoint sparql:query {
        ?n list:in (1 2 3 4 5) .
        ?n math:notLessThan 3 .
    } .
    # SELECT * WHERE {
    #   VALUES ?n { 1 2 3 4 5 }
    #   FILTER (?n >= 3)
    # }
} 
=> 
{ 
    math:notLessThan :result ?n . 
} .

{ 
    :test :enabled math:equalTo .
    :let :endpoint ?endpoint .
    ?endpoint sparql:query {
        ?n list:in (1 2 3 4 5) .
        ?n math:equalTo 4 .
    } .
    # SELECT * WHERE {
    #   VALUES ?n { 1 2 3 4 5 }
    #   FILTER (?n = 4)
    # }
} 
=> 
{ 
    math:equalTo ex:result ?n .
} .

{ 
    :test :enabled math:notEqualTo .
    :let :endpoint ?endpoint .
    ?endpoint sparql:query {
        (1 2 3 4 5) list:member ?n .
        ?n math:notEqualTo 1 , 2 , 5 .
    } .
    # SELECT * WHERE {
    #   VALUES ?n { 1 2 3 4 5 }
    #   FILTER (?n != 1)
    #   FILTER (?n != 2)
    #   FILTER (?n != 5)
    # }
} 
=> 
{ 
    math:notEqualTo ex:result ?n .
} .


{ 
    :test :enabled math:sum .
    :let :endpoint ?endpoint .
    ?endpoint sparql:query {
        ?n list:in (1) .
        (2 3 ?n) math:sum ?sum .
    } .
    # SELECT * WHERE {
    #   VALUES ?n { 1 }
    #   BIND(2 + 3 + ?n AS ?sum)
    # }
} 
=> 
{ 
    math:sum :result1 ?sum . 
} .

{ 
    :test :enabled math:sum .
    :let :endpoint ?endpoint .
    ?endpoint sparql:query {
        ?n list:in (1 2) .
        (?n 5) math:sum 7 .
    } .
    # SELECT * WHERE {
    #   VALUES ?n { 1 2 }
    #   FILTER(?n + 5 = 7)
    # }
} 
=> 
{ 
    math:sum :result2 ?n . 
} .


{ 
    :test :enabled math:product .
    :let :endpoint ?endpoint .
    ?endpoint sparql:query {
        ?n list:in (1) .
        (2 3 ?n) math:product ?prod .
    } .
    # SELECT * WHERE {
    #   VALUES ?n { 1 }
    #   BIND(2 * 3 * ?n AS ?prod)
    # }
} 
=> 
{ 
    math:product :result ?prod .
} .

{ 
    :test :enabled math:product .
    :let :endpoint ?endpoint .
    ?endpoint sparql:query {
        ?n list:in (5 4) .
        ?prod list:in (6 8) .
        (?n 2) math:product ?prod .
    } .
    # SELECT * WHERE {
    #   VALUES ?n { 5 4 }
    #   VALUES ?prod { 6 8 }
    #   FILTER(?n * 2 = ?prod)
    # }
} 
=> 
{ 
    math:product :result (?n ?prod) .
} .

