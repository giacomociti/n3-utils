    :test :enabled math:difference .
    :let :endpoint ?endpoint .
    ?endpoint sparql:query {
        ?n list:in (2 4) .
        (7 ?n) math:difference 3 .
    } .
    # SELECT * WHERE {
    #   VALUES ?n { 2 4 }
    #   FILTER(7 - ?n = 3)
    # }
} 
=> 
{ 
    math:difference :result2 ?n . 
} .

