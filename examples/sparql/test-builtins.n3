{ 
    ex:test ex:enabled ex:testDateTime .
    ex:let ex:endpoint ?endpoint .
    ?endpoint sparql:query {
        ("2026-01-20T10:20:30Z"^^xsd:dateTime) list:member ?d .
        ?d time:day ?day .
        ?d time:minute ?minute .
        ?d time:month ?month .
        ?d time:second ?second .
        ?d time:timezone ?timezone .
        ?d time:year ?year .
    } .
    # SELECT * WHERE {
    #   VALUES ?d { "2026-01-20T10:20:30Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> }
    #   BIND(DAY(?d) AS ?day)
    #   BIND(MINUTES(?d) AS ?minute)
    #   BIND(MONTH(?d) AS ?month)
    #   BIND(SECONDS(?d) AS ?second)
    #   BIND(TZ(?d) AS ?timezone)
    #   BIND(YEAR(?d) AS ?year)
    # }
} 
=> 
{ 
    ex:result ex:year ?year .
    ex:result ex:month ?month .
    ex:result ex:day ?day .
    ex:result ex:minute ?minute .
    ex:result ex:second ?second .
    ex:result ex:timezone ?timezone .
} .

{ 
    ex:test ex:enabled ex:testDateTime .
    ex:let ex:endpoint ?endpoint .
    ?endpoint sparql:query {
        ("2026-01-20T10:20:30Z"^^xsd:dateTime "2025-01-20T10:20:30Z"^^xsd:dateTime) list:member ?d .
        ?d time:day 20 .
        ?d time:minute 20 .
        ?d time:month 1 .
        ?d time:second 30 .
        ?d time:timezone "Z" .
        ?d time:year 2026 .
    } .
    # SELECT * WHERE {
    #   VALUES ?d { "2026-01-20T10:20:30Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> "2025-01-20T10:20:30Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> }
    #   FILTER(DAY(?d) = 20)
    #   FILTER(MINUTES(?d) = 20)
    #   FILTER(MONTH(?d) = 1)
    #   FILTER(SECONDS(?d) = 30)
    #   FILTER(TZ(?d) = "Z")
    #   FILTER(YEAR(?d) = 2026)
    # }
} 
=> 
{ 
    ex:result ex:date ?d . # expected "2026-01-20T10:20:30Z"^^xsd:dateTime
   
} .


{ 
    :test :enabled list:member .
    :let :endpoint ?endpoint .
    ?endpoint sparql:query {
        (1 "a" ex:b) list:member ?member .
    } .
    # SELECT * WHERE {
    #   VALUES ?member { 1 "a" <http://example.org/b> }
    # }
} 
=> 
{ 
    list:member :result1 ?member .
} .

{ 
    :test :enabled list:member .
    :let :endpoint ?endpoint .
    ?endpoint sparql:query {
        (1 2 3) list:member ?x .
        (3 4 5) list:member ?x . 
    } .
    # SELECT * WHERE {
    #   VALUES ?x { 1 2 3 }
    #   FILTER(?x IN (3, 4, 5))
    # }
} 
=> 
{ 
    list:member :result2 ?x . 
} .

{ 
    :test :enabled list:in .
    :let :endpoint ?endpoint .
    ?endpoint sparql:query {
        ?member list:in (1 "a" ex:b) .
    } .
    # SELECT * WHERE {
    #   VALUES ?member { 1 "a" <http://example.org/b> }
    # }
} 
=> 
{ 
    list:in :result1 ?member .
} .

{ 
    :test :enabled list:in .
    :let :endpoint ?endpoint .
    ?endpoint sparql:query {
        ?x list:in (1 2 3) .
        ?x list:in (3 4 5) . 
    } .
    # SELECT * WHERE {
    #   VALUES ?x { 1 2 3 }
    #   FILTER(?x IN (3, 4, 5))
    # }
} 
=> 
{ 
    list:in :result2 ?x . 
} .


{ 
    :test :enabled log:dtlit .
    :let :endpoint ?endpoint .
    ?endpoint sparql:query {
        ?x list:in ("1" 2) .
        (?x xsd:int) log:dtlit ?dtlit .
    } .
    # SELECT * WHERE {
    #   VALUES ?x { "1" 2 }
    #   BIND(STRDT(STR(?x), <http://www.w3.org/2001/XMLSchema#int>) AS ?dtlit)
    # }
} 
=> 
{ 
    log:dtlit ex:result1 ?dtlit . 
} .

{ 
    :test :enabled log:dtlit .
    :let :endpoint ?endpoint .
    ?endpoint sparql:query {
        ?x list:in (1.2 "a"@en) .
        (?lex ?dt) log:dtlit ?x .
    } .
    # SELECT * WHERE {
    #   VALUES ?x { 1.2 "a"@en }
    #   BIND(STR(?x) AS ?lex)
    #   BIND(DATATYPE(?x) AS ?dt)
    # }
} 
=> 
{ 
    log:dtlit ex:result2 (?lex ?dt). 
    # expected ("1.2" xsd:decimal), ("a" rdf:langString)
    # Note: Qlever returns xsd:double instead of xsd:decimal
} .

{ 
    :test :enabled log:dtlit .
    :let :endpoint ?endpoint .
    ?endpoint sparql:query {
        ?x list:in ("a" 3) .
        (?lex xsd:string) log:dtlit ?x .
    } .
    # SELECT * WHERE {
    #   VALUES ?x { "a" 3 }
    #   BIND(STR(?x) AS ?lex)
    #   FILTER(DATATYPE(?x) = <http://www.w3.org/2001/XMLSchema#string>)
    # }
} 
=> 
{ 
    log:dtlit ex:result3 ?lex . 
} .

{ 
    :test :enabled log:dtlit .
    :let :endpoint ?endpoint .
    ?endpoint sparql:query {
        (xsd:string xsd:double) list:member ?dt .
        ("a" 3) list:member ?x .
        ("a" ?dt) log:dtlit ?x .
    } .
    # SELECT * WHERE {
    #   VALUES ?dt { <http://www.w3.org/2001/XMLSchema#string> <http://www.w3.org/2001/XMLSchema#double> }
    #   VALUES ?x { "a" 3 }
    #   FILTER(STR(?x) = "a")
    #   FILTER(DATATYPE(?x) = ?dt)
    # }
} 
=> 
{ 
    log:dtlit ex:result4 ?dt . 
} .

{ 
    :test :enabled log:langlit .
    :let :endpoint ?endpoint .
    ?endpoint sparql:query {
        ?x list:in ("a") .
        (?x 'en') log:langlit ?langlit .
    } .
    # SELECT * WHERE {
    #   VALUES ?x { "a" }
    #   BIND(STRLANG(STR(?x), "en") AS ?langlit)
    # }
} 
=> 
{ 
    log:langlit ex:result1 ?langlit . 
} .

{ 
    :test :enabled log:langlit .
    :let :endpoint ?endpoint .
    ?endpoint sparql:query {
        ?x list:in ("a"@en) .
        (?lex ?lang) log:langlit ?x .
    } .
    # SELECT * WHERE {
    #   VALUES ?x { "a"@en }
    #   BIND(STR(?x) AS ?lex)
    #   BIND(LANG(?x) AS ?lang)
    # }
} 
=> 
{ 
    log:langlit ex:result2 (?lex ?lang). 
} .

{ 
    :test :enabled log:langlit .
    :let :endpoint ?endpoint .
    ?endpoint sparql:query {
        ?x list:in ("a"@en) .
        (?lex 'en') log:langlit ?x .
    } .
    # SELECT * WHERE {
    #   VALUES ?x { "a"@en }
    #   BIND(STR(?x) AS ?lex)
    #   FILTER(LANG(?x) = "en")
    # }
} 
=> 
{ 
    log:langlit ex:result3 ?lex .
} .

{ 
    :test :enabled log:langlit .
    :let :endpoint ?endpoint .
    ?endpoint sparql:query {
        ?lang list:in ("en" "de") .
        ?x list:in ("a"@en) .
        ("a" ?lang) log:langlit ?x .
    } .
    # SELECT * WHERE {
    #   VALUES ?lang { "en" "de" }
    #   VALUES ?x { "a"@en }
    #   FILTER(STR(?x) = "a")
    #   FILTER(LANG(?x) = ?lang)
    # }
} 
=> 
{ 
    log:langlit ex:result4 ?lang . 
} .

{ 
    :test :enabled log:includes .
    :let :endpoint ?endpoint .
    ?endpoint sparql:query {
        ?s list:in ("a" "b") .
        [] log:includes {

        } .
    } .
    # SELECT *
    # WHERE {
    #   VALUES ?s { "a" "b" }
    #   FILTER EXISTS { 
    #   }
    # }
} 
=> 
{ 
    log:includes :result ?s .
} .

{ 
    :test :enabled log:notIncludes .
    :let :endpoint ?endpoint .
    ?endpoint sparql:query {
        ?s list:in ("a" "b") .
        [] log:notIncludes {
             ?t list:in ("b") .
             ?t log:equalTo ?s .
        } .
    } .
    # SELECT *
    # WHERE {
    #   VALUES ?s { "a" "b" }
    #   FILTER NOT EXISTS { 
    #     VALUES ?t { "b" }
    #       FILTER(?t = ?s)
    #     }
    # }
} 
=> 
{ 
    log:notIncludes :result ?s .
} .

{
    :test :enabled string:concatenation . 
    :let :endpoint ?endpoint .
