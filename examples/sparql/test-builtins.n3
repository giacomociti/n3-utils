{ 
    :test :enabled string:replace .
    :let :endpoint ?endpoint .
    ?endpoint sparql:query {
        ?x list:in ("abc") .
        (?x "a" "c") string:replace ?replaced.
    } .
    # SELECT *
    # WHERE {
    #   VALUES ?x { "abc" }
    #   BIND(REPLACE(STR(?x), STR("a"), "c") AS ?replaced)
    # }
} 
=> 
{ 
    string:replace :result ?replaced . 
} .

{ 
    :test :enabled string:startsWith .
    :let :endpoint ?endpoint .
    ?endpoint sparql:query {
        ?x list:in ("abc" "acc") .
        ?x string:startsWith "ab".
    } .
    # SELECT *
    # WHERE {
    #   VALUES ?x { "abc" "acc" }
    #   FILTER(STRSTARTS(?x, "ab"))
    # }
} 
=> 
{ 
    string:startsWith :result ?x .
} .