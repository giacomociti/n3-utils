# generic rules to create simple shapes (without targets) from r2rml mappings

@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix string: <http://www.w3.org/2000/10/swap/string#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix : <#> .

{ ?triplesMap rr:subjectMap [] } => { 
    [] prov:wasDerivedFrom ?triplesMap 
} .

{ ?shape prov:wasDerivedFrom [ rr:subjectMap [ rr:class ?class ] ] } => {
     ?shape sh:class ?class 
} .

{ ?shape prov:wasDerivedFrom [ rr:predicateObjectMap [ rr:predicate ?path ] ]} => { 
    ?shape sh:property [ sh:path ?path] 
} .

{  
    ?shape prov:wasDerivedFrom ?triplesMap ;
        sh:property ?property .
    ?property sh:path ?path .
    ?triplesMap
        rr:predicateObjectMap [
            rr:predicate ?path;
            rr:objectMap [ :nodeKind ?nodeKind ]
        ].
} => { 
    ?property sh:nodeKind ?nodeKind
} .

{ ?objectMap :nodeKind sh:Literal } <= { ?objectMap rr:column [] } .
{ ?objectMap :nodeKind sh:IRI } <= { ?objectMap rr:template [] } .

# rr:constant => sh:hasValue
{  
    ?shape prov:wasDerivedFrom ?triplesMap ;
        sh:property ?property .    
    ?property sh:path ?path .
    ?triplesMap
        rr:predicateObjectMap [
            rr:predicate ?path;
            rr:objectMap [ rr:constant ?constant ]
        ].
} => { 
    ?property sh:hasValue ?constant
} .

# rr:datatype => sh:datatype
{  
    ?shape prov:wasDerivedFrom ?triplesMap ;
        sh:property ?property .     
    ?property sh:path ?path .
    ?triplesMap
        rr:predicateObjectMap [
            rr:predicate ?path;
            rr:objectMap [ rr:datatype ?datatype ]
        ].
} => { 
    ?property sh:datatype ?datatype
} .

# rr:language => rdf:langString
{  
    ?shape prov:wasDerivedFrom ?triplesMap ;
        sh:property ?property .     
    ?property sh:path ?path .
    ?triplesMap
        rr:predicateObjectMap [
            rr:predicate ?path;
            rr:objectMap [ rr:language [] ]
        ].
} => { 
    ?property sh:datatype rdf:langString
} .

# rr:template => sh:pattern
{  
    ?shape prov:wasDerivedFrom ?triplesMap ;
        sh:property ?property .     
    ?property sh:path ?path .
    ?triplesMap
        rr:predicateObjectMap [
            rr:predicate ?path;
            rr:objectMap [ rr:template ?template ]
        ].
    (?template "{[^{}]*}" ".*") string:replace ?pattern .
} => { 
    ?property sh:pattern ?pattern
} .

{ 
    ?shape prov:wasDerivedFrom [ rr:subjectMap [ rr:template ?template ] ] .
    (?template "{[^{}]*}" ".*") string:replace ?pattern .

} => { ?shape sh:pattern ?pattern } .